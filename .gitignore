# Git Ignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production builds
dist/
build/
.next/
out/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/

# Build artifacts
*.tsbuildinfo
tsconfig.tsbuildinfo

# Temp files
tmp/
temp/
*.temp

# Logs
logs/
*.log

# OS
Thumbs.db
.DS_Store

# Vendor license tool (keep EXE and signing secret off git)
vendor-tools/PMP-License-Generator/node_modules/
vendor-tools/PMP-License-Generator/dist/
vendor-tools/PMP-License-Generator/src/embedded-secret.js
vendor-tools/PMP-License-Generator/.license-signing-secret
*.lic

# Package manager
package-lock.json
yarn.lock
pnpm-lock.yaml

# IDE specific
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
